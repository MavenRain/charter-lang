-- The check accepts this program and `langc eval` computes each ind on
-- Option. An ind on a constant Option reduces (D26). In pickGet the
-- scrutinee is a run-time value, and `langc ir` lowers the ind as a case
-- split.
optGet : (o : Option ℕ) → ℕ
optGet o = ind (λ (x : Option ℕ) → ℕ) 0 (λ (n : ℕ) → natAdd n 1) o

someGet : (n : ℕ) → ℕ
someGet n = optGet (some n)

noneGet : (n : ℕ) → ℕ
noneGet n = natAdd n (optGet none)

pickGet : (n : ℕ) → ℕ
pickGet n = optGet (flagIf (natLe n 2) (some n) none)
