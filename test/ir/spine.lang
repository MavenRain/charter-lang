-- The spine lowerings. Each FreeMon ℕ here exists only at run time, so
-- `langc ir` walks its spine. The gate compares `langc eval` results.
fmSum : (n : ℕ) → ℕ
fmSum n = fold 0 (λ (h : ℕ) (acc : ℕ) → natAdd h acc) (fold (λ (s : FreeMon ℕ) → fmCons ℕ 5 s) (fmNil ℕ) n)

-- The last fmCons has a trapped tail.
fmTrap : (n : ℕ) → ℕ
fmTrap n = fold 0 (λ (h : ℕ) (acc : ℕ) → h) (fold (λ (s : FreeMon ℕ) → fmCons ℕ 5 s) (fmCons ℕ 7 (fold (λ (s : FreeMon ℕ) → s) (fmNil ℕ) (natAdd 18446744073709551615 1))) n)

-- Consuming the recursive rest must propagate its trap.
fmDemand : (n : ℕ) → ℕ
fmDemand n = fold 0 (λ (h : ℕ) (acc : ℕ) → natAdd h acc) (fold (λ (s : FreeMon ℕ) → fmCons ℕ 5 s) (fmCons ℕ 7 (fold (λ (s : FreeMon ℕ) → s) (fmNil ℕ) (natAdd 18446744073709551615 1))) n)
