-- A lazy trap. The second field of the pair overflows after two steps, but
-- the entry reads only the first field. `langc eval lazy 3` gives 3.
start : ℕ × ℕ
start = pack 0 2

step : (p : ℕ × ℕ) → ℕ × ℕ
step p = pack (natAdd (witness p) 1) (natMul (payload p) 18446744073709551615)

lazy : (n : ℕ) → ℕ
lazy n = witness (fold step start n)
