evidence : ℕ → Eq ℕ 0 0
evidence n = flagIf (natEq (natAdd n 1) 0) refl refl

proofMove : ℕ → ℕ
proofMove n = transport (λ (x : ℕ) → ℕ) (evidence n) 7

proofSymm : ℕ → ℕ
proofSymm n = transport (λ (x : ℕ) → ℕ) (symm (evidence n)) 7

baseProof : Eq ℕ 0 0
baseProof = refl

proofTrans : ℕ → ℕ
proofTrans n = transport (λ (x : ℕ) → ℕ) (trans baseProof (evidence n)) 7

proofCong : ℕ → ℕ
proofCong n = transport (λ (x : ℕ) → ℕ) (cong (λ (x : ℕ) → x) (evidence n)) 7
