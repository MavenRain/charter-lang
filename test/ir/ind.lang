-- The check accepts this program and `langc eval` computes each ind. The
-- Wasm host has no ind, so `langc ir` must refuse it with REFUSE_RUNTIME_TREE.
double : (n : ℕ) → ℕ
double n = ind (λ (m : ℕ) → ℕ) 0 (λ (k : ℕ) (ih : ℕ) → natAdd ih 2) n

bump : (k : ℕ) → ℕ
bump k = double (natAdd k 1)

bumpLaw : (k : ℕ) → Eq ℕ (bump k) (natAdd (double k) 2)
bumpLaw k = refl
