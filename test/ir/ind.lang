-- The check accepts this program and `langc eval` computes each ind.
-- `langc ir` lowers an ind on a run-time ℕ as a counter pass (REPEAT).
double : (n : ℕ) → ℕ
double n = ind (λ (m : ℕ) → ℕ) 0 (λ (k : ℕ) (ih : ℕ) → natAdd ih 2) n

bump : (k : ℕ) → ℕ
bump k = double (natAdd k 1)

bumpLaw : (k : ℕ) → Eq ℕ (bump k) (natAdd (double k) 2)
bumpLaw k = refl
