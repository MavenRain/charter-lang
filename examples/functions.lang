-- Formers F9 and F10: functions and dependent functions.
id : (n : ℕ) → ℕ
id n = n

next : ℕ → ℕ
next n = natAdd n 1

twice : (f : (n : ℕ) → ℕ) → (n : ℕ) → ℕ
twice f n = f (f n)

four : ℕ
four = twice next 2

pairOf : (x : ℕ) → (y : ℕ) → ℕ × ℕ
pairOf x y = pack x y

poly : (A : Type 0) → (x : A) → A
poly A x = x

three : ℕ
three = poly ℕ 3

applied : ℕ
applied = (λ (n : ℕ) → natMul n n) 6
