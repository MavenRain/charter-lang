-- Entries: first-order ℕ and Bool definitions. The target exports them.
addPrice : (a : ℕ) → (b : ℕ) → ℕ
addPrice a b = natAdd a b

scale : (a : ℕ) → (k : ℕ) → ℕ
scale a k = natMul a k

discount : (a : ℕ) → (d : ℕ) → ℕ
discount a d = natSub a d

cheap : (a : ℕ) → Bool
cheap a = natLe a 100

square : (n : ℕ) → ℕ
square n = fold (λ (acc : ℕ) → natAdd acc n) 0 n

pick : (f : Bool) → (a : ℕ) → (b : ℕ) → ℕ
pick f a b = flagIf f a b

-- Shared values: the lowering shares a value in a block. shareArms uses one value
-- in the two arms of flagIf. shareDeep doubles the value 16 times.
dbl : (t : ℕ) → ℕ
dbl t = natAdd t t

shareTwice : (u : ℕ) → ℕ
shareTwice u = (λ (t : ℕ) → natAdd t t) (natMul u u)

shareArms : (u : ℕ) → (v : ℕ) → ℕ
shareArms u v = (λ (t : ℕ) → flagIf (natEq u 0) t (natAdd t 1)) (natMul v v)

shareDeep : (u : ℕ) → ℕ
shareDeep u = dbl (dbl (dbl (dbl (dbl (dbl (dbl (dbl (dbl (dbl (dbl (dbl (dbl (dbl (dbl (dbl u)))))))))))))))
