-- Former F5: pure, map and bind over Option and Sum E.
lifted : Option ℕ
lifted = map (λ (n : ℕ) → natAdd n 1) (some 4)

chained : Option ℕ
chained = bind (some 4) (λ (n : ℕ) → some (natMul n 2))

wrapped : Option ℕ
wrapped = pure 5

okRight : Sum Bool ℕ
okRight = map (λ (n : ℕ) → natAdd n 1) (inr 3)

okBind : Sum Bool ℕ
okBind = bind (inr 3) (λ (n : ℕ) → inl false)
