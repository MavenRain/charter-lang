-- Three votes of members 1, 2 and 3 on claim 0 (n = 4, t = 3), then w.
votes3 : (d : DecE) → (w : FreeMon (Op natCMon)) → FreeMon (Op natCMon)
votes3 d w = fmCons (Op natCMon) (opVote natCMon (address 1) 0 (voteE d)) (fmCons (Op natCMon) (opVote natCMon (address 2) 0 (voteE d)) (fmCons (Op natCMon) (opVote natCMon (address 3) 0 (voteE d)) w))

settle0 : FreeMon (Op natCMon)
