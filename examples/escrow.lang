-- Invariant I at the address key k of s: the ledger value is the sum of
-- the open claims of that payer.
invIAt : (s : St natCMon) → (k : ℕ) → Bool
invIAt s k = natEq (ledgerGet natCMon (stLedger natCMon s) (address k)) (sumClaims natCMon (stClaims natCMon s) (address k))

-- Invariant I at each key of the ledger and at each payer of an open
-- claim. At an address in neither, both sides are 0.
invIState : (s : St natCMon) → Bool
invIState s = fold (fold true (λ (h : ℕ × Claim natCMon) (acc : Bool) → flagIf (invIAt s (addressKey (claimPayer natCMon (payload h)))) acc false) (stClaims natCMon s)) (λ (h : ℕ × cmCarrier natCMon) (acc : Bool) → flagIf (invIAt s (witness h)) acc false) (stLedger natCMon s)

-- The result none gives false: each law point below also says that the
-- transcript is valid.
invIOf : (t : T natCMon (St natCMon)) → Bool
invIOf t = option false (λ (q : St natCMon × FreeMon (Voucher natCMon)) → invIState (witness q)) t

-- Cor 4.2: n <= ledger(p) for each open claim (p, q, n).
corOf : (t : T natCMon (St natCMon)) → Bool
corOf t = option false (λ (q : St natCMon × FreeMon (Voucher natCMon)) → fold true (λ (h : ℕ × Claim natCMon) (acc : Bool) → flagIf (natLe (claimAmount natCMon (payload h)) (ledgerGet natCMon (stLedger natCMon (witness q)) (claimPayer natCMon (payload h)))) acc false) (stClaims natCMon (witness q))) t

-- Conservation: the sum over the spent receipts is the sum of the ledger,
-- the credit and the vouchers of the output.
consOf : (t : T natCMon (St natCMon)) → Bool
consOf t = option false (λ (q : St natCMon × FreeMon (Voucher natCMon)) → natEq (spentSum (stSpent natCMon (witness q))) (natAdd (ledgerSum natCMon (stLedger natCMon (witness q))) (natAdd (ledgerSum natCMon (stCredit natCMon (witness q))) (voucherSum natCMon (payload q))))) t

