-- Invariant I (Thm 4.1), Cor 4.2 and Conservation (Thm 4.4) on one valid
-- transcript from S_0 (n = 4). Payer 1 makes the claim 0 (40 to payee 2)
-- and the claim 1 (25 to payee 3). Payer 3 makes the claim 2 (10 to payee
-- 4). Then Release of claim 0, Refund of claim 1, Hold of claim 2, a
-- withdraw of 20 by member 2 and an Adopt of kappaEx7 (motion 16) occur.
-- iT1 to iT6 are the results after each part. These are law points, not
-- a general proof (D68).
receiptB : Receipt natCMon
receiptB = receipt natCMon 6 25

receiptC : Receipt natCMon
receiptC = receipt natCMon 7 10

-- The values of the receipts of the examples, by key.
nuTable : FreeMon (ℕ × ℕ)
nuTable = nmapSet ℕ (nmapSet ℕ (nmapSet ℕ (fmNil (ℕ × ℕ)) 5 40) 6 25) 7 10

-- The sum of nu over the spent receipts.
spentSum : (sp : FreeMon ℕ) → ℕ
spentSum sp = fold 0 (λ (k : ℕ) (acc : ℕ) → natAdd (option 0 (λ (x : ℕ) → x) (nmapGet ℕ nuTable k)) acc) sp

depOp : (p : ℕ) → (q : ℕ) → (r : Receipt natCMon) → (w : FreeMon (Op natCMon)) → FreeMon (Op natCMon)
depOp p q r w = fmCons (Op natCMon) (opDeposit natCMon (address p) (address q) r) w

votes3At : (c : ℕ) → (d : DecE) → (w : FreeMon (Op natCMon)) → FreeMon (Op natCMon)
votes3At c d w = fmCons (Op natCMon) (opVote natCMon (address 1) c (voteE d)) (fmCons (Op natCMon) (opVote natCMon (address 2) c (voteE d)) (fmCons (Op natCMon) (opVote natCMon (address 3) c (voteE d)) w))

-- A Release, a Refund and a Hold ballot: the verdict is Hold.
holdVotes : (c : ℕ) → (w : FreeMon (Op natCMon)) → FreeMon (Op natCMon)
holdVotes c w = fmCons (Op natCMon) (opVote natCMon (address 1) c (voteE decRelease)) (fmCons (Op natCMon) (opVote natCMon (address 2) c (voteE decRefund)) (fmCons (Op natCMon) (opVote natCMon (address 3) c (voteE decHold)) w))

settleAt : (c : ℕ) → (w : FreeMon (Op natCMon)) → FreeMon (Op natCMon)
settleAt c w = fmCons (Op natCMon) (opSettle natCMon c) w

iDep : (w : FreeMon (Op natCMon)) → FreeMon (Op natCMon)
iDep w = depOp 1 2 receiptEx (depOp 1 3 receiptB (depOp 3 4 receiptC w))

iRel : (w : FreeMon (Op natCMon)) → FreeMon (Op natCMon)
iRel w = votes3At 0 decRelease (settleAt 0 w)

iRef : (w : FreeMon (Op natCMon)) → FreeMon (Op natCMon)
iRef w = votes3At 1 decRefund (settleAt 1 w)

iHold : (w : FreeMon (Op natCMon)) → FreeMon (Op natCMon)
iHold w = holdVotes 2 (settleAt 2 w)

iWd : (w : FreeMon (Op natCMon)) → FreeMon (Op natCMon)
iWd w = fmCons (Op natCMon) (opWithdraw natCMon (address 2) 20) w

-- Member 1 puts kappaEx7 at the entry index 16, members 1 to 4 vote
-- Adopt (tA = 4) and enact 16 runs.
iAdopt : (w : FreeMon (Op natCMon)) → FreeMon (Op natCMon)
iAdopt w = fmCons (Op natCMon) (opMotion natCMon (address 1) kappaEx7) (fmCons (Op natCMon) (opVote natCMon (address 1) 16 (voteA ballotAdopt)) (fmCons (Op natCMon) (opVote natCMon (address 2) 16 (voteA ballotAdopt)) (fmCons (Op natCMon) (opVote natCMon (address 3) 16 (voteA ballotAdopt)) (fmCons (Op natCMon) (opVote natCMon (address 4) 16 (voteA ballotAdopt)) (fmCons (Op natCMon) (opEnact natCMon 16) w)))))

