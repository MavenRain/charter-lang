-- Prop 3.4 (W1): any two quorums (coalitions of at least t members) share
-- more than f(n) members, for n = 4 (t = 3) and n = 7 (t = 5). At t = 2 on
-- n = 4, W1 fails and two quorums can share no member (D70). subsets gives
-- each subset of the members one time.
subsets : (xs : FreeMon Address) → FreeMon (FreeMon Address)
subsets xs = fold (fmCons (FreeMon Address) (fmNil Address) (fmNil (FreeMon Address))) (λ (h : Address) (acc : FreeMon (FreeMon Address)) → fold (fmNil (FreeMon Address)) (λ (s : FreeMon Address) (r : FreeMon (FreeMon Address)) → fmCons (FreeMon Address) s (fmCons (FreeMon Address) (fmCons Address h s) r)) acc) xs

quorums : (xs : FreeMon Address) → (t : ℕ) → FreeMon (FreeMon Address)
quorums xs t = fold (fmNil (FreeMon Address)) (λ (s : FreeMon Address) (r : FreeMon (FreeMon Address)) → flagIf (natLe t (fmLength Address s)) (fmCons (FreeMon Address) s r) r) (subsets xs)

memberOf : (xs : FreeMon Address) → (m : Address) → Bool
memberOf xs m = fold false (λ (h : Address) (acc : Bool) → flagIf (natEq (addressKey h) (addressKey m)) true acc) xs

meetSize : (a : FreeMon Address) → (b : FreeMon Address) → ℕ
meetSize a b = fold 0 (λ (h : Address) (acc : ℕ) → flagIf (memberOf b h) (natAdd acc 1) acc) a

quorumsMeet : (k : Kappa) → Bool
quorumsMeet k = fold true (λ (a : FreeMon Address) (acc : Bool) → fold acc (λ (b : FreeMon Address) (acc2 : Bool) → flagIf (natLt (faultBound (kappaN k)) (meetSize a b)) acc2 false) (quorums (kappaMembers k) (kappaT k))) (quorums (kappaMembers k) (kappaT k))

