-- The operations deposit, cast, vote, balance, amend and propose, opStep
-- and the transcript meaning tSem on s0 and s1. exState t is the state of
-- t, or s0 for none.
exState : (t : T natCMon (St natCMon)) → St natCMon
exState t = option s0 (λ (q : St natCMon × FreeMon (Voucher natCMon)) → witness q) t

