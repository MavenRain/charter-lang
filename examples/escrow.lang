-- opStep fits the op type of tSem, so tSem gives the transcript meaning.
semEscrow : (w : FreeMon (Op natCMon)) → (s : St natCMon) → T natCMon (St natCMon)
semEscrow w s = tSem natCMon (Op natCMon) (St natCMon) (opStep natCMon) w s

-- A transcript of 2 ops on s0: a deposit, then a vote of address 2 on the
-- claim 0.
w2 : FreeMon (Op natCMon)
w2 = fmCons (Op natCMon) (opDeposit natCMon (address 1) (address 2) receiptEx) (fmCons (Op natCMon) (opVote natCMon (address 2) 0 (voteE decRelease)) (fmNil (Op natCMon)))

s2Ex : St natCMon
s2Ex = stMk natCMon kappaEx4 0 2 (ledgerAdd natCMon (fmNil (ℕ × ℕ)) (address 1) 40) (fmNil (ℕ × ℕ)) (nmapSet (Claim natCMon) (fmNil (ℕ × Claim natCMon)) 0 (pack (address 1) (pack (address 2) 40))) (fmCons ℕ 5 (fmNil ℕ)) (nmapSet (FreeMon (Option DecE)) (fmNil (ℕ × FreeMon (Option DecE))) 0 (fmCons (Option DecE) none (fmCons (Option DecE) (some decRelease) (fmCons (Option DecE) none (fmCons (Option DecE) none (fmNil (Option DecE))))))) (fmNil (ℕ × Motion))

semW2 : Eq (T natCMon (St natCMon)) (semEscrow w2 s0) (tRet natCMon (St natCMon) s2Ex)
semW2 = refl

