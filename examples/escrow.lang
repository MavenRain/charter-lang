-- The vouchers of a result.
outOf : (t : T natCMon (St natCMon)) → FreeMon (Voucher natCMon)
outOf t = option (fmNil (Voucher natCMon)) (λ (q : St natCMon × FreeMon (Voucher natCMon)) → payload q) t

