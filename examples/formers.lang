-- Formers F1 to F3: products, sums and options.
price : ℕ
price = 1200

both : ℕ × Bool
both = pack price true

left : ℕ
left = witness both

right : Bool
right = payload both

size : (n : ℕ) → ℕ
size n = natAdd n 1

count : (n : ℕ) → ℕ
count n = n

choice : Sum ℕ ℕ
choice = inr 5

picked : ℕ
picked = either size count choice

nothing : Option ℕ
nothing = none

something : Option ℕ
something = some 7

orZero : (o : Option ℕ) → ℕ
orZero o = option 0 (λ (n : ℕ) → n) o
