-- Formers F12 and F13: equality, transport and congruence.
price : ℕ
price = 1200

cost : ℕ
cost = 1200

same : Eq ℕ price cost
same = refl

back : Eq ℕ cost price
back = symm same

round : Eq ℕ price price
round = trans same back

moved : (P : (n : ℕ) → Type 0) → (u : P price) → P cost
moved P u = transport P same u

bumped : Eq ℕ (natAdd price 1) (natAdd cost 1)
bumped = cong (λ (n : ℕ) → natAdd n 1) same
