-- The charter-lang domain (PLAN 3.1). Each data type, constructor, field
-- and definition name here becomes a core name (rule R4). Only this file
-- can declare a data type (rule R1).
-- The free monoid on A (rule R1, second class, Q-S2a-2). `langc ir` walks
-- a FreeMon ℕ spine (test/ir/spine.lang).
data FreeMon (A : Type 0) : Type where
  fmNil : FreeMon A
  fmCons : (fmHead : A) → (fmTail : FreeMon A) → FreeMon A

fmAppend : (A : Type 0) → (xs : FreeMon A) → (ys : FreeMon A) → FreeMon A
fmAppend A xs ys = fold ys (λ (h : A) (acc : FreeMon A) → fmCons A h acc) xs

-- The monoid laws of fmAppend with the unit fmNil A.
fmUnitL : (A : Type 0) → (ys : FreeMon A) → Eq (FreeMon A) (fmAppend A (fmNil A) ys) ys
fmUnitL A ys = refl

fmUnitR : (A : Type 0) → (xs : FreeMon A) → Eq (FreeMon A) (fmAppend A xs (fmNil A)) xs
fmUnitR A xs = ind (λ (x : FreeMon A) → Eq (FreeMon A) (fmAppend A x (fmNil A)) x) refl (λ (h : A) (t : FreeMon A) (ih : Eq (FreeMon A) (fmAppend A t (fmNil A)) t) → cong (λ (y : FreeMon A) → fmCons A h y) ih) xs

fmAssoc : (A : Type 0) → (xs : FreeMon A) → (ys : FreeMon A) → (zs : FreeMon A) → Eq (FreeMon A) (fmAppend A (fmAppend A xs ys) zs) (fmAppend A xs (fmAppend A ys zs))
fmAssoc A xs ys zs = ind (λ (x : FreeMon A) → Eq (FreeMon A) (fmAppend A (fmAppend A x ys) zs) (fmAppend A x (fmAppend A ys zs))) refl (λ (h : A) (t : FreeMon A) (ih : Eq (FreeMon A) (fmAppend A (fmAppend A t ys) zs) (fmAppend A t (fmAppend A ys zs))) → cong (λ (y : FreeMon A) → fmCons A h y) ih) xs

-- The length of a list.
fmLength : (A : Type 0) → (xs : FreeMon A) → ℕ
fmLength A xs = fold 0 (λ (h : A) (acc : ℕ) → natAdd acc 1) xs

-- Kit regression subject, not charter data: a fold over a Tree that exists
-- at run time is a HOST-LIMIT (test/ir/tree.lang; Q-S2a-1 (a)).
data Tree : Type where
  tip : Tree
  fork : (forkLeft : Tree) → (forkRight : Tree) → Tree

-- Escrow decisions D_E. Escrow ballots are B_E = D_E (L226).
data DecE : Type where
  decRelease : DecE
  decRefund : DecE
  decHold : DecE

-- Amendment ballots B_A and amendment decisions D_A (L226).
data BallotA : Type where
  ballotAdopt : BallotA
  ballotReject : BallotA

data DecA : Type where
  amendAdopt : DecA
  amendReject : DecA
  amendHold : DecA

-- A flag (L515, L551 to L554). The kit type Bool stays a host name.
data Bit : Type where
  bitZero : Bit
  bitOne : Bit

-- An opaque key (L256, L360): one field over a ℕ key.
data Address : Type where
  address : (addressKey : ℕ) → Address

-- The assets A (L227, Q8): a cancellative commutative monoid with a
-- decidable order. monus b a = some d if and only if a + d = b.
CMon : Type 1
CMon = (carrier : Type 0) × (add : (x : carrier) → (y : carrier) → carrier) × (zero : carrier) × (assoc : (a : carrier) → (b : carrier) → (c : carrier) → Eq carrier (add (add a b) c) (add a (add b c))) × (unitL : (a : carrier) → Eq carrier (add zero a) a) × (unitR : (a : carrier) → Eq carrier (add a zero) a) × (comm : (a : carrier) → (b : carrier) → Eq carrier (add a b) (add b a)) × (cancel : (a : carrier) → (b : carrier) → (c : carrier) → (e : Eq carrier (add a c) (add b c)) → Eq carrier a b) × (monus : (x : carrier) → (y : carrier) → Option carrier) × (monusSound : (a : carrier) → (b : carrier) → (d : carrier) → (e : Eq (Option carrier) (monus b a) (some d)) → Eq carrier (add a d) b) × ((a : carrier) → (d : carrier) → Eq (Option carrier) (monus (add a d) a) (some d))

cmCarrier : (M : CMon) → Type 0
cmCarrier M = witness M

cmAdd : (M : CMon) → (x : cmCarrier M) → (y : cmCarrier M) → cmCarrier M
cmAdd M = witness (payload M)

cmZero : (M : CMon) → cmCarrier M
cmZero M = witness (payload (payload M))

cmAssoc : (M : CMon) → (a : cmCarrier M) → (b : cmCarrier M) → (c : cmCarrier M) → Eq (cmCarrier M) (cmAdd M (cmAdd M a b) c) (cmAdd M a (cmAdd M b c))
cmAssoc M = witness (payload (payload (payload M)))

cmUnitL : (M : CMon) → (a : cmCarrier M) → Eq (cmCarrier M) (cmAdd M (cmZero M) a) a
cmUnitL M = witness (payload (payload (payload (payload M))))

cmUnitR : (M : CMon) → (a : cmCarrier M) → Eq (cmCarrier M) (cmAdd M a (cmZero M)) a
cmUnitR M = witness (payload (payload (payload (payload (payload M)))))

cmComm : (M : CMon) → (a : cmCarrier M) → (b : cmCarrier M) → Eq (cmCarrier M) (cmAdd M a b) (cmAdd M b a)
cmComm M = witness (payload (payload (payload (payload (payload (payload M))))))

cmCancel : (M : CMon) → (a : cmCarrier M) → (b : cmCarrier M) → (c : cmCarrier M) → (e : Eq (cmCarrier M) (cmAdd M a c) (cmAdd M b c)) → Eq (cmCarrier M) a b
cmCancel M = witness (payload (payload (payload (payload (payload (payload (payload M)))))))

cmMonus : (M : CMon) → (x : cmCarrier M) → (y : cmCarrier M) → Option (cmCarrier M)
cmMonus M = witness (payload (payload (payload (payload (payload (payload (payload (payload M))))))))

cmMonusSound : (M : CMon) → (a : cmCarrier M) → (b : cmCarrier M) → (d : cmCarrier M) → (e : Eq (Option (cmCarrier M)) (cmMonus M b a) (some d)) → Eq (cmCarrier M) (cmAdd M a d) b
cmMonusSound M = witness (payload (payload (payload (payload (payload (payload (payload (payload (payload M)))))))))

cmMonusComplete : (M : CMon) → (a : cmCarrier M) → (d : cmCarrier M) → Eq (Option (cmCarrier M)) (cmMonus M (cmAdd M a d) a) (some d)
cmMonusComplete M = payload (payload (payload (payload (payload (payload (payload (payload (payload (payload M)))))))))

-- A voucher (a, n, i) that the rail pays (L228): address, amount, index.
Voucher : (M : CMon) → Type 0
Voucher M = Address × cmCarrier M × ℕ

voucherAddress : (M : CMon) → (v : Voucher M) → Address
voucherAddress M v = witness v

voucherAmount : (M : CMon) → (v : Voucher M) → cmCarrier M
voucherAmount M v = witness (payload v)

voucherIndex : (M : CMon) → (v : Voucher M) → ℕ
voucherIndex M v = payload (payload v)

-- A claim (p, q, n) (L257): payer, payee and amount.
Claim : (M : CMon) → Type 0
Claim M = Address × Address × cmCarrier M

claimPayer : (M : CMon) → (c : Claim M) → Address
claimPayer M c = witness c

claimPayee : (M : CMon) → (c : Claim M) → Address
claimPayee M c = witness (payload c)

claimAmount : (M : CMon) → (c : Claim M) → cmCarrier M
claimAmount M c = payload (payload c)

-- A pair of ℕ. A bare pack has no type to infer, so flagIf and ind take
-- this typed form.
pairNN : (a : ℕ) → (b : ℕ) → ℕ × ℕ
pairNN a b = pack a b

-- The fault bound f(n) = (n - 1) / 3 rounded down (L240), by ind over ℕ on
-- a counter (quotient, remainder mod 3). The builtins have no division.
faultStep : (s : ℕ × ℕ) → ℕ × ℕ
faultStep s = flagIf (natEq (payload s) 2) (pairNN (natAdd (witness s) 1) 0) (pairNN (witness s) (natAdd (payload s) 1))

faultBound : (n : ℕ) → ℕ
faultBound n = witness (ind (λ (m : ℕ) → ℕ × ℕ) (pairNN 0 0) (λ (j : ℕ) (s : ℕ × ℕ) → faultStep s) (natSub n 1))

natLt : (a : ℕ) → (b : ℕ) → Bool
natLt a b = flagIf (natLe b a) false true

-- A tally c : D_E + {bot} -> ℕ with sum c = n (Def 2.2, L236): the counts
-- of Release, Refund, Hold and bot, and a proof that the sum is n. A tally
-- represents the orbit X // Sym(M) (Q7 (a), no HIT).
Tally : (n : ℕ) → Type 0
Tally n = (cRel : ℕ) × (cRef : ℕ) × (cHold : ℕ) × (cBot : ℕ) × Eq ℕ (natAdd (natAdd (natAdd cRel cRef) cHold) cBot) n

tallyRelease : (n : ℕ) → (c : Tally n) → ℕ
tallyRelease n c = witness c

tallyRefund : (n : ℕ) → (c : Tally n) → ℕ
tallyRefund n c = witness (payload c)

tallyHold : (n : ℕ) → (c : Tally n) → ℕ
tallyHold n c = witness (payload (payload c))

tallyBot : (n : ℕ) → (c : Tally n) → ℕ
tallyBot n c = witness (payload (payload (payload c)))

tallySum : (n : ℕ) → (c : Tally n) → Eq ℕ (natAdd (natAdd (natAdd (tallyRelease n c) (tallyRefund n c)) (tallyHold n c)) (tallyBot n c)) n
tallySum n c = payload (payload (payload (payload c)))

-- theta as data (Q-S3-1 (a)): a Rule names a decision rule, and ruleApply
-- gives its function on a Tally n. The first rule is the threshold rule
-- theta_t of Ex 2.5: Release if c(Release) >= t, Refund if c(Refund) >= t,
-- else Hold.
data Rule : Type where
  ruleThreshold : (ruleThresholdT : ℕ) → Rule

ruleApply : (r : Rule) → (n : ℕ) → (c : Tally n) → DecE
ruleApply r n c = fold (λ (t : ℕ) → flagIf (natLe t (tallyRelease n c)) decRelease (flagIf (natLe t (tallyRefund n c)) decRefund decHold)) r

-- The threshold rule theta_t (Ex 2.5) as a function: ruleThreshold t under
-- ruleApply.
thetaThreshold : (n : ℕ) → (t : ℕ) → (c : Tally n) → DecE
thetaThreshold n t c = ruleApply (ruleThreshold t) n c

-- Ready_t(X) if and only if n - tau(X)(bot) >= t (Def 2.3).
tallyReady : (n : ℕ) → (t : ℕ) → (c : Tally n) → Bool
tallyReady n t c = natLe t (natSub n (tallyBot n c))

-- The constitution kappa = (M, t, tA, theta) (Def 2.1, L234). The member
-- set M is a FreeMon Address with strictly ascending keys (D40), and n is
-- its length. theta is a Rule (Q-S3-1 (a)), and ruleApply takes a Tally n,
-- so F = theta o tau is constant on orbits (W3 by construction, Q7).
Kappa : Type 0
Kappa = (members : FreeMon Address) × (thr : ℕ) × (thrA : ℕ) × Rule

kappaMembers : (k : Kappa) → FreeMon Address
kappaMembers k = witness k

kappaN : (k : Kappa) → ℕ
kappaN k = fmLength Address (kappaMembers k)

kappaT : (k : Kappa) → ℕ
kappaT k = witness (payload k)

kappaTA : (k : Kappa) → ℕ
kappaTA k = witness (payload (payload k))

kappaRule : (k : Kappa) → Rule
kappaRule k = payload (payload (payload k))

kappaTheta : (k : Kappa) → (c : Tally (kappaN k)) → DecE
kappaTheta k c = ruleApply (kappaRule k) (kappaN k) c

-- The keys of xs ascend strictly, so M is a set (D40). A right pass keeps
-- the key of the next member (none at the end), so it adds no successor.
kappaAscending : (xs : FreeMon Address) → Bool
kappaAscending xs = witness (ind (λ (x : FreeMon Address) → (ok : Bool) × Option ℕ) (pack true none) (λ (h : Address) (t : FreeMon Address) (acc : (ok : Bool) × Option ℕ) → pack (flagIf (witness acc) (option true (λ (p : ℕ) → natLt (addressKey h) p) (payload acc)) false) (some (addressKey h))) xs)

-- W1: n + f(n) < 2t and t <= n - f(n). W2: t <= tA <= n (Def 2.4).
kappaW1Of : (n : ℕ) → (t : ℕ) → Bool
kappaW1Of n t = flagIf (natLt (natAdd n (faultBound n)) (natAdd t t)) (natLe t (natSub n (faultBound n))) false

kappaW2Of : (n : ℕ) → (t : ℕ) → (tA : ℕ) → Bool
kappaW2Of n t tA = flagIf (natLe t tA) (natLe tA n) false

kappaW1 : (k : Kappa) → Bool
kappaW1 k = kappaW1Of (kappaN k) (kappaT k)

kappaW2 : (k : Kappa) → Bool
kappaW2 k = kappaW2Of (kappaN k) (kappaT k) (kappaTA k)

-- kappa is well formed if its keys ascend and W1 and W2 hold. W3 holds by
-- the type of ruleApply.
kappaWellFormed : (k : Kappa) → Bool
kappaWellFormed k = flagIf (kappaAscending (kappaMembers k)) (flagIf (kappaW1 k) (kappaW2 k) false) false

-- K_wf: the well-formed constitutions (Q1 (a)).
KappaWf : Type 0
KappaWf = (k : Kappa) × Eq Bool (kappaWellFormed k) true

-- natAdd (natAdd k 1) a = natAdd (natAdd k a) 1, by ind on a. Conv moves
-- 1 out of the right argument only, so the tally steps use this proof.
natAddOneL : (k : ℕ) → (a : ℕ) → Eq ℕ (natAdd (natAdd k 1) a) (natAdd (natAdd k a) 1)
natAddOneL k a = ind (λ (m : ℕ) → Eq ℕ (natAdd (natAdd k 1) m) (natAdd (natAdd k m) 1)) refl (λ (m : ℕ) (ih : Eq ℕ (natAdd (natAdd k 1) m) (natAdd (natAdd k m) 1)) → cong (λ (x : ℕ) → natAdd x 1) ih) a

-- tau(X)(d) = |X^{-1}(d)| (Def 2.2, L236). A ballot vector X is a FreeMon
-- (Option DecE) in key order, and none is bot. Each step adds 1 to one
-- count and to n.
tallyZero : Tally 0
tallyZero = pack 0 (pack 0 (pack 0 (pack 0 refl)))

tallyAddBot : (n : ℕ) → (c : Tally n) → Tally (natAdd n 1)
tallyAddBot n c = pack (tallyRelease n c) (pack (tallyRefund n c) (pack (tallyHold n c) (pack (natAdd (tallyBot n c) 1) (cong (λ (y : ℕ) → natAdd y 1) (tallySum n c)))))

tallyAddHold : (n : ℕ) → (c : Tally n) → Tally (natAdd n 1)
tallyAddHold n c = pack (tallyRelease n c) (pack (tallyRefund n c) (pack (natAdd (tallyHold n c) 1) (pack (tallyBot n c) (trans (natAddOneL (natAdd (natAdd (tallyRelease n c) (tallyRefund n c)) (tallyHold n c)) (tallyBot n c)) (cong (λ (y : ℕ) → natAdd y 1) (tallySum n c))))))

tallyAddRefund : (n : ℕ) → (c : Tally n) → Tally (natAdd n 1)
tallyAddRefund n c = pack (tallyRelease n c) (pack (natAdd (tallyRefund n c) 1) (pack (tallyHold n c) (pack (tallyBot n c) (trans (cong (λ (y : ℕ) → natAdd y (tallyBot n c)) (natAddOneL (natAdd (tallyRelease n c) (tallyRefund n c)) (tallyHold n c))) (trans (natAddOneL (natAdd (natAdd (tallyRelease n c) (tallyRefund n c)) (tallyHold n c)) (tallyBot n c)) (cong (λ (y : ℕ) → natAdd y 1) (tallySum n c)))))))

tallyAddRelease : (n : ℕ) → (c : Tally n) → Tally (natAdd n 1)
tallyAddRelease n c = pack (natAdd (tallyRelease n c) 1) (pack (tallyRefund n c) (pack (tallyHold n c) (pack (tallyBot n c) (trans (cong (λ (y : ℕ) → natAdd (natAdd y (tallyHold n c)) (tallyBot n c)) (natAddOneL (tallyRelease n c) (tallyRefund n c))) (trans (cong (λ (y : ℕ) → natAdd y (tallyBot n c)) (natAddOneL (natAdd (tallyRelease n c) (tallyRefund n c)) (tallyHold n c))) (trans (natAddOneL (natAdd (natAdd (tallyRelease n c) (tallyRefund n c)) (tallyHold n c)) (tallyBot n c)) (cong (λ (y : ℕ) → natAdd y 1) (tallySum n c))))))))

tallyAddDec : (n : ℕ) → (c : Tally n) → (d : DecE) → Tally (natAdd n 1)
tallyAddDec n c d = ind (λ (e : DecE) → Tally (natAdd n 1)) (tallyAddRelease n c) (tallyAddRefund n c) (tallyAddHold n c) d

tallyAdd : (n : ℕ) → (x : Option DecE) → (c : Tally n) → Tally (natAdd n 1)
tallyAdd n x c = option (tallyAddBot n c) (λ (d : DecE) → tallyAddDec n c d) x

tauE : (xs : FreeMon (Option DecE)) → Tally (fmLength (Option DecE) xs)
tauE xs = ind (λ (x : FreeMon (Option DecE)) → Tally (fmLength (Option DecE) x)) tallyZero (λ (h : Option DecE) (t : FreeMon (Option DecE)) (ih : Tally (fmLength (Option DecE) t)) → tallyAdd (fmLength (Option DecE) t) h ih) xs

-- F = theta o tau (Def 2.4). F reads X only through tau(X), so F is
-- constant on orbits (W3). The proof e gives the length n of X.
kappaF : (k : Kappa) → (xs : FreeMon (Option DecE)) → (e : Eq ℕ (fmLength (Option DecE) xs) (kappaN k)) → DecE
kappaF k xs e = kappaTheta k (transport (λ (m : ℕ) → Tally m) e (tauE xs))

-- An amendment tally c : B_A + {bot} -> ℕ with sum c = n (L226): the
-- counts of Adopt, Reject and bot, and a proof that the sum is n.
TallyA : (n : ℕ) → Type 0
TallyA n = (cAdopt : ℕ) × (cReject : ℕ) × (cBot : ℕ) × Eq ℕ (natAdd (natAdd cAdopt cReject) cBot) n

tallyAdopt : (n : ℕ) → (c : TallyA n) → ℕ
tallyAdopt n c = witness c

tallyReject : (n : ℕ) → (c : TallyA n) → ℕ
tallyReject n c = witness (payload c)

tallyABot : (n : ℕ) → (c : TallyA n) → ℕ
tallyABot n c = witness (payload (payload c))

tallyASum : (n : ℕ) → (c : TallyA n) → Eq ℕ (natAdd (natAdd (tallyAdopt n c) (tallyReject n c)) (tallyABot n c)) n
tallyASum n c = payload (payload (payload c))

-- tau(Y) on an amendment ballot vector Y : FreeMon (Option BallotA).
tallyAZero : TallyA 0
tallyAZero = pack 0 (pack 0 (pack 0 refl))

tallyAAddBot : (n : ℕ) → (c : TallyA n) → TallyA (natAdd n 1)
tallyAAddBot n c = pack (tallyAdopt n c) (pack (tallyReject n c) (pack (natAdd (tallyABot n c) 1) (cong (λ (y : ℕ) → natAdd y 1) (tallyASum n c))))

tallyAAddReject : (n : ℕ) → (c : TallyA n) → TallyA (natAdd n 1)
tallyAAddReject n c = pack (tallyAdopt n c) (pack (natAdd (tallyReject n c) 1) (pack (tallyABot n c) (trans (natAddOneL (natAdd (tallyAdopt n c) (tallyReject n c)) (tallyABot n c)) (cong (λ (y : ℕ) → natAdd y 1) (tallyASum n c)))))

tallyAAddAdopt : (n : ℕ) → (c : TallyA n) → TallyA (natAdd n 1)
tallyAAddAdopt n c = pack (natAdd (tallyAdopt n c) 1) (pack (tallyReject n c) (pack (tallyABot n c) (trans (cong (λ (y : ℕ) → natAdd y (tallyABot n c)) (natAddOneL (tallyAdopt n c) (tallyReject n c))) (trans (natAddOneL (natAdd (tallyAdopt n c) (tallyReject n c)) (tallyABot n c)) (cong (λ (y : ℕ) → natAdd y 1) (tallyASum n c))))))

tallyAAddBallot : (n : ℕ) → (c : TallyA n) → (v : BallotA) → TallyA (natAdd n 1)
tallyAAddBallot n c v = ind (λ (e : BallotA) → TallyA (natAdd n 1)) (tallyAAddAdopt n c) (tallyAAddReject n c) v

tallyAAdd : (n : ℕ) → (x : Option BallotA) → (c : TallyA n) → TallyA (natAdd n 1)
tallyAAdd n x c = option (tallyAAddBot n c) (λ (v : BallotA) → tallyAAddBallot n c v) x

tauA : (ys : FreeMon (Option BallotA)) → TallyA (fmLength (Option BallotA) ys)
tauA ys = ind (λ (y : FreeMon (Option BallotA)) → TallyA (fmLength (Option BallotA) y)) tallyAZero (λ (h : Option BallotA) (t : FreeMon (Option BallotA)) (ih : TallyA (fmLength (Option BallotA) t)) → tallyAAdd (fmLength (Option BallotA) t) h ih) ys

-- The amendment rule Amd_tA (L395): Adopt if c(Adopt) >= tA, Reject if
-- c(Reject) > n - tA, else Hold. The two cases exclude each other.
amdThreshold : (n : ℕ) → (tA : ℕ) → (c : TallyA n) → DecA
amdThreshold n tA c = flagIf (natLe tA (tallyAdopt n c)) amendAdopt (flagIf (natLt (natSub n tA) (tallyReject n c)) amendReject amendHold)

kappaAmd : (k : Kappa) → (c : TallyA (kappaN k)) → DecA
kappaAmd k c = amdThreshold (kappaN k) (kappaTA k) c

-- T M Z (Q-S2b-2): the composite Option (Z × FreeMon (Voucher M)) of
-- Q5. The value none is a stop. The value some (z, o) is a result z and
-- the output o. emit v none = none holds by construction.
T : (M : CMon) → (Z : Type 0) → Type 0
T M Z = Option (Z × FreeMon (Voucher M))

tOut : (M : CMon) → (Z : Type 0) → (z : Z) → (o : FreeMon (Voucher M)) → T M Z
tOut M Z z o = some (pack z o)

tRet : (M : CMon) → (Z : Type 0) → (z : Z) → T M Z
tRet M Z z = tOut M Z z (fmNil (Voucher M))

tNone : (M : CMon) → (Z : Type 0) → T M Z
tNone M Z = none

-- tPre M Z o t puts the output o before the output of t.
tPre : (M : CMon) → (Z : Type 0) → (o : FreeMon (Voucher M)) → (t : T M Z) → T M Z
tPre M Z o t = option none (λ (q : Z × FreeMon (Voucher M)) → tOut M Z (witness q) (fmAppend (Voucher M) o (payload q))) t

tEmit : (M : CMon) → (Z : Type 0) → (v : Voucher M) → (t : T M Z) → T M Z
tEmit M Z v t = tPre M Z (fmCons (Voucher M) v (fmNil (Voucher M))) t

tBind : (M : CMon) → (Y : Type 0) → (Z : Type 0) → (t : T M Y) → (f : (y : Y) → T M Z) → T M Z
tBind M Y Z t f = option none (λ (p : Y × FreeMon (Voucher M)) → tPre M Z (payload p) (f (witness p))) t

-- The Kleisli arrow a >=> b (L285).
tKleisli : (M : CMon) → (X : Type 0) → (Y : Type 0) → (Z : Type 0) → (a : (x : X) → T M Y) → (b : (y : Y) → T M Z) → (x : X) → T M Z
tKleisli M X Y Z a b x = tBind M Y Z (a x) b

-- The laws of T, by ind on Option and on FreeMon (fmUnitR, fmAssoc).
tPreNil : (M : CMon) → (Z : Type 0) → (t : T M Z) → Eq (T M Z) (tPre M Z (fmNil (Voucher M)) t) t
tPreNil M Z t = ind (λ (u : T M Z) → Eq (T M Z) (tPre M Z (fmNil (Voucher M)) u) u) refl (λ (q : Z × FreeMon (Voucher M)) → refl) t

tPrePre : (M : CMon) → (Z : Type 0) → (o : FreeMon (Voucher M)) → (o2 : FreeMon (Voucher M)) → (t : T M Z) → Eq (T M Z) (tPre M Z (fmAppend (Voucher M) o o2) t) (tPre M Z o (tPre M Z o2 t))
tPrePre M Z o o2 t = ind (λ (u : T M Z) → Eq (T M Z) (tPre M Z (fmAppend (Voucher M) o o2) u) (tPre M Z o (tPre M Z o2 u))) refl (λ (q : Z × FreeMon (Voucher M)) → cong (λ (w : FreeMon (Voucher M)) → tOut M Z (witness q) w) (fmAssoc (Voucher M) o o2 (payload q))) t

tBindPre : (M : CMon) → (Y : Type 0) → (Z : Type 0) → (o : FreeMon (Voucher M)) → (t : T M Y) → (g : (y : Y) → T M Z) → Eq (T M Z) (tBind M Y Z (tPre M Y o t) g) (tPre M Z o (tBind M Y Z t g))
tBindPre M Y Z o t g = ind (λ (u : T M Y) → Eq (T M Z) (tBind M Y Z (tPre M Y o u) g) (tPre M Z o (tBind M Y Z u g))) refl (λ (q : Y × FreeMon (Voucher M)) → tPrePre M Z o (payload q) (g (witness q))) t

tUnitL : (M : CMon) → (Y : Type 0) → (Z : Type 0) → (y : Y) → (f : (y : Y) → T M Z) → Eq (T M Z) (tBind M Y Z (tRet M Y y) f) (f y)
tUnitL M Y Z y f = tPreNil M Z (f y)

tUnitR : (M : CMon) → (Z : Type 0) → (t : T M Z) → Eq (T M Z) (tBind M Z Z t (tRet M Z)) t
tUnitR M Z t = ind (λ (u : T M Z) → Eq (T M Z) (tBind M Z Z u (tRet M Z)) u) refl (λ (q : Z × FreeMon (Voucher M)) → cong (λ (w : FreeMon (Voucher M)) → tOut M Z (witness q) w) (fmUnitR (Voucher M) (payload q))) t

tAssoc : (M : CMon) → (X : Type 0) → (Y : Type 0) → (Z : Type 0) → (t : T M X) → (f : (x : X) → T M Y) → (g : (y : Y) → T M Z) → Eq (T M Z) (tBind M Y Z (tBind M X Y t f) g) (tBind M X Z t (λ (x : X) → tBind M Y Z (f x) g))
tAssoc M X Y Z t f g = ind (λ (u : T M X) → Eq (T M Z) (tBind M Y Z (tBind M X Y u f) g) (tBind M X Z u (λ (x : X) → tBind M Y Z (f x) g))) refl (λ (q : X × FreeMon (Voucher M)) → tBindPre M Y Z (payload q) (f (witness q)) g) t

-- The Kleisli laws (L285 to L289): two units and associativity.
tKUnitL : (M : CMon) → (X : Type 0) → (Y : Type 0) → (a : (x : X) → T M Y) → (x : X) → Eq (T M Y) (tKleisli M X X Y (tRet M X) a x) (a x)
tKUnitL M X Y a x = tUnitL M X Y x a

tKUnitR : (M : CMon) → (X : Type 0) → (Y : Type 0) → (a : (x : X) → T M Y) → (x : X) → Eq (T M Y) (tKleisli M X Y Y a (tRet M Y) x) (a x)
tKUnitR M X Y a x = tUnitR M Y (a x)

tKAssoc : (M : CMon) → (W : Type 0) → (X : Type 0) → (Y : Type 0) → (Z : Type 0) → (a : (w : W) → T M X) → (b : (x : X) → T M Y) → (c : (y : Y) → T M Z) → (w : W) → Eq (T M Z) (tKleisli M W Y Z (tKleisli M W X Y a b) c w) (tKleisli M W X Z a (tKleisli M X Y Z b c) w)
tKAssoc M W X Y Z a b c w = tAssoc M X Y Z (a w) b c

-- The transcript fold of Thm 3.1 (L287 to L289): sem eps = eta and
-- sem (x w) = op x >=> sem w, generic over an op X -> S -> T M S.
tSem : (M : CMon) → (X : Type 0) → (S : Type 0) → (op : (x : X) → (s : S) → T M S) → (w : FreeMon X) → (s : S) → T M S
tSem M X S op w = fold (tRet M S) (λ (h : X) (acc : (s : S) → T M S) → tKleisli M S S S (op h) acc) w

-- tBind respects a pointwise equality of the continuations.
tBindExt : (M : CMon) → (Y : Type 0) → (Z : Type 0) → (t : T M Y) → (f : (y : Y) → T M Z) → (g : (y : Y) → T M Z) → (e : (y : Y) → Eq (T M Z) (f y) (g y)) → Eq (T M Z) (tBind M Y Z t f) (tBind M Y Z t g)
tBindExt M Y Z t f g e = ind (λ (u : T M Y) → Eq (T M Z) (tBind M Y Z u f) (tBind M Y Z u g)) refl (λ (q : Y × FreeMon (Voucher M)) → cong (λ (u : T M Z) → tPre M Z (payload q) u) (e (witness q))) t

tSemCons : (M : CMon) → (X : Type 0) → (S : Type 0) → (op : (x : X) → (s : S) → T M S) → (x : X) → (w : FreeMon X) → (s : S) → Eq (T M S) (tSem M X S op (fmCons X x w) s) (tKleisli M S S S (op x) (tSem M X S op w) s)
tSemCons M X S op x w s = refl

-- Thm 3.1 (L287): sem eps = eta.
tSemNil : (M : CMon) → (X : Type 0) → (S : Type 0) → (op : (x : X) → (s : S) → T M S) → Eq ((s : S) → T M S) (tSem M X S op (fmNil X)) (tRet M S)
tSemNil M X S op = refl

-- Thm 3.1 (L287): sem (w ++ w2) = sem w >=> sem w2, at each state s.
tSemAppend : (M : CMon) → (X : Type 0) → (S : Type 0) → (op : (x : X) → (s : S) → T M S) → (w : FreeMon X) → (w2 : FreeMon X) → (s : S) → Eq (T M S) (tSem M X S op (fmAppend X w w2) s) (tKleisli M S S S (tSem M X S op w) (tSem M X S op w2) s)
tSemAppend M X S op w w2 = ind (λ (x : FreeMon X) → (s : S) → Eq (T M S) (tSem M X S op (fmAppend X x w2) s) (tKleisli M S S S (tSem M X S op x) (tSem M X S op w2) s)) (λ (s : S) → symm (tKUnitL M S S (tSem M X S op w2) s)) (λ (h : X) (t : FreeMon X) (ih : (s : S) → Eq (T M S) (tSem M X S op (fmAppend X t w2) s) (tKleisli M S S S (tSem M X S op t) (tSem M X S op w2) s)) (s : S) → trans (tBindExt M S S (op h s) (tSem M X S op (fmAppend X t w2)) (tKleisli M S S S (tSem M X S op t) (tSem M X S op w2)) ih) (symm (tKAssoc M S S S S (op h) (tSem M X S op t) (tSem M X S op w2) s))) w

-- A receipt iota of the rail: an opaque key and its value nu(iota) (D53).
data Receipt (M : CMon) : Type where
  receipt : (receiptKey : ℕ) → (receiptValue : cmCarrier M) → Receipt M

receiptId : (M : CMon) → (r : Receipt M) → ℕ
receiptId M r = ind (λ (x : Receipt M) → ℕ) (λ (k : ℕ) (v : cmCarrier M) → k) r

receiptNu : (M : CMon) → (r : Receipt M) → cmCarrier M
receiptNu M r = ind (λ (x : Receipt M) → cmCarrier M) (λ (k : ℕ) (v : cmCarrier M) → v) r

-- A map keyed by ℕ (D52): a list of entries whose keys ascend strictly.
-- nmapSet keeps that order, so two maps with the same entries are the
-- same list. A key that is not in the map gives none.
nmapGet : (V : Type 0) → (m : FreeMon (ℕ × V)) → (c : ℕ) → Option V
nmapGet V m c = ind (λ (x : FreeMon (ℕ × V)) → Option V) none (λ (h : ℕ × V) (t : FreeMon (ℕ × V)) (ih : Option V) → flagIf (natEq (witness h) c) (some (payload h)) ih) m

-- nmapSet V m c v puts the value v at the key c.
nmapSet : (V : Type 0) → (m : FreeMon (ℕ × V)) → (c : ℕ) → (v : V) → FreeMon (ℕ × V)
nmapSet V m c v = ind (λ (x : FreeMon (ℕ × V)) → FreeMon (ℕ × V)) (fmCons (ℕ × V) (pack c v) (fmNil (ℕ × V))) (λ (h : ℕ × V) (t : FreeMon (ℕ × V)) (ih : FreeMon (ℕ × V)) → flagIf (natEq (witness h) c) (fmCons (ℕ × V) (pack c v) t) (flagIf (natLt c (witness h)) (fmCons (ℕ × V) (pack c v) (fmCons (ℕ × V) h t)) (fmCons (ℕ × V) h ih))) m

-- nmapDel V m c removes the key c.
nmapDel : (V : Type 0) → (m : FreeMon (ℕ × V)) → (c : ℕ) → FreeMon (ℕ × V)
nmapDel V m c = ind (λ (x : FreeMon (ℕ × V)) → FreeMon (ℕ × V)) (fmNil (ℕ × V)) (λ (h : ℕ × V) (t : FreeMon (ℕ × V)) (ih : FreeMon (ℕ × V)) → flagIf (natEq (witness h) c) t (fmCons (ℕ × V) h ih)) m

-- A map Address -> A (ledger and credit), keyed by addressKey. An address
-- that is not in the map has the value 0 of A.
Ledger : (M : CMon) → Type 0
Ledger M = FreeMon (ℕ × cmCarrier M)

ledgerGet : (M : CMon) → (m : Ledger M) → (a : Address) → cmCarrier M
ledgerGet M m a = option (cmZero M) (λ (x : cmCarrier M) → x) (nmapGet (cmCarrier M) m (addressKey a))

-- ledgerAdd M m a n adds n to the value of a.
ledgerAdd : (M : CMon) → (m : Ledger M) → (a : Address) → (n : cmCarrier M) → Ledger M
ledgerAdd M m a n = nmapSet (cmCarrier M) m (addressKey a) (cmAdd M (ledgerGet M m a) n)

-- ledgerSub M m a n subtracts n from the value of a. The value none
-- means that n is more than the value of a.
ledgerSub : (M : CMon) → (m : Ledger M) → (a : Address) → (n : cmCarrier M) → Option (Ledger M)
ledgerSub M m a n = option none (λ (d : cmCarrier M) → some (nmapSet (cmCarrier M) m (addressKey a) d)) (cmMonus M (ledgerGet M m a) n)

-- The spent set: the keys of the spent receipts.
spentHas : (s : FreeMon ℕ) → (k : ℕ) → Bool
spentHas s k = fold false (λ (h : ℕ) (acc : Bool) → flagIf (natEq h k) true acc) s

-- The configuration bot^M of escrow ballots: one none for each member.
botEOf : (xs : FreeMon Address) → FreeMon (Option DecE)
botEOf xs = ind (λ (x : FreeMon Address) → FreeMon (Option DecE)) (fmNil (Option DecE)) (λ (h : Address) (t : FreeMon Address) (ih : FreeMon (Option DecE)) → fmCons (Option DecE) none ih) xs

botE : (k : Kappa) → FreeMon (Option DecE)
botE k = botEOf (kappaMembers k)

-- bot^M has the length n of M, so tauE gives a Tally n.
botELen : (xs : FreeMon Address) → Eq ℕ (fmLength (Option DecE) (botEOf xs)) (fmLength Address xs)
botELen xs = ind (λ (x : FreeMon Address) → Eq ℕ (fmLength (Option DecE) (botEOf x)) (fmLength Address x)) refl (λ (h : Address) (t : FreeMon Address) (ih : Eq ℕ (fmLength (Option DecE) (botEOf t)) (fmLength Address t)) → cong (λ (y : ℕ) → natAdd y 1) ih) xs

-- The configuration bot^M of amendment ballots.
botAOf : (xs : FreeMon Address) → FreeMon (Option BallotA)
botAOf xs = ind (λ (x : FreeMon Address) → FreeMon (Option BallotA)) (fmNil (Option BallotA)) (λ (h : Address) (t : FreeMon Address) (ih : FreeMon (Option BallotA)) → fmCons (Option BallotA) none ih) xs

botA : (k : Kappa) → FreeMon (Option BallotA)
botA k = botAOf (kappaMembers k)

botALen : (xs : FreeMon Address) → Eq ℕ (fmLength (Option BallotA) (botAOf xs)) (fmLength Address xs)
botALen xs = ind (λ (x : FreeMon Address) → Eq ℕ (fmLength (Option BallotA) (botAOf x)) (fmLength Address x)) refl (λ (h : Address) (t : FreeMon Address) (ih : Eq ℕ (fmLength (Option BallotA) (botAOf t)) (fmLength Address t)) → cong (λ (y : ℕ) → natAdd y 1) ih) xs

-- An open motion (Gamma_A): the proposed kappa' and the configuration of
-- the amendment ballots. A closed motion leaves the map (D54).
Motion : Type 0
Motion = Kappa × FreeMon (Option BallotA)

motionKappa : (j : Motion) → Kappa
motionKappa j = witness j

motionConfig : (j : Motion) → FreeMon (Option BallotA)
motionConfig j = payload j

-- The state s: kappa, the epoch, the position pos of the next entry,
-- ledger, credit, the open claims by index, the spent receipt keys,
-- Gamma_E (one configuration for each open claim) and Gamma_A (each open
-- motion). A settled claim leaves the maps (D54). L = L_kappa is not a
-- field: the clear meaning computes it from kappa (Q7 (a)).
St : (M : CMon) → Type 0
St M = Kappa × ℕ × ℕ × Ledger M × Ledger M × FreeMon (ℕ × Claim M) × FreeMon ℕ × FreeMon (ℕ × FreeMon (Option DecE)) × FreeMon (ℕ × Motion)

stMk : (M : CMon) → (k : Kappa) → (e : ℕ) → (p : ℕ) → (l : Ledger M) → (cr : Ledger M) → (cl : FreeMon (ℕ × Claim M)) → (sp : FreeMon ℕ) → (ge : FreeMon (ℕ × FreeMon (Option DecE))) → (ga : FreeMon (ℕ × Motion)) → St M
stMk M k e p l cr cl sp ge ga = pack k (pack e (pack p (pack l (pack cr (pack cl (pack sp (pack ge ga)))))))

stKappa : (M : CMon) → (s : St M) → Kappa
stKappa M s = witness s

stEpoch : (M : CMon) → (s : St M) → ℕ
stEpoch M s = witness (payload s)

stPos : (M : CMon) → (s : St M) → ℕ
stPos M s = witness (payload (payload s))

stLedger : (M : CMon) → (s : St M) → Ledger M
stLedger M s = witness (payload (payload (payload s)))

stCredit : (M : CMon) → (s : St M) → Ledger M
stCredit M s = witness (payload (payload (payload (payload s))))

stClaims : (M : CMon) → (s : St M) → FreeMon (ℕ × Claim M)
stClaims M s = witness (payload (payload (payload (payload (payload s)))))

stSpent : (M : CMon) → (s : St M) → FreeMon ℕ
stSpent M s = witness (payload (payload (payload (payload (payload (payload s))))))

stGammaE : (M : CMon) → (s : St M) → FreeMon (ℕ × FreeMon (Option DecE))
stGammaE M s = witness (payload (payload (payload (payload (payload (payload (payload s)))))))

stGammaA : (M : CMon) → (s : St M) → FreeMon (ℕ × Motion)
stGammaA M s = payload (payload (payload (payload (payload (payload (payload (payload s)))))))

-- The start state S_0 for a constitution kappa: epoch 0, position 0 and
-- empty maps.
stInit : (M : CMon) → (k : Kappa) → St M
stInit M k = stMk M k 0 0 (fmNil (ℕ × cmCarrier M)) (fmNil (ℕ × cmCarrier M)) (fmNil (ℕ × Claim M)) (fmNil ℕ) (fmNil (ℕ × FreeMon (Option DecE))) (fmNil (ℕ × Motion))

-- The position of the member m in xs (the first position is 0), or none
-- if m is not a member.
memberIndex : (xs : FreeMon Address) → (m : Address) → Option ℕ
memberIndex xs m = ind (λ (x : FreeMon Address) → Option ℕ) none (λ (h : Address) (t : FreeMon Address) (ih : Option ℕ) → flagIf (natEq (addressKey h) (addressKey m)) (some 0) (option none (λ (i : ℕ) → some (natAdd i 1)) ih)) xs

-- fmSetLen V v i n xs puts v at the position i of xs, when n is the length
-- of xs. A right pass counts k, the members after the member h, so h is at
-- the position i when natSub n (k + 1) = i. k + 1 <= n, so no underflow.
fmSetLen : (V : Type 0) → (v : V) → (i : ℕ) → (n : ℕ) → (xs : FreeMon V) → FreeMon V
fmSetLen V v i n xs = payload (ind (λ (x : FreeMon V) → (k : ℕ) × FreeMon V) (pack 0 (fmNil V)) (λ (h : V) (t : FreeMon V) (acc : (k : ℕ) × FreeMon V) → pack (natAdd (witness acc) 1) (fmCons V (flagIf (natEq (natSub n (natAdd (witness acc) 1)) i) v h) (payload acc))) xs)

-- fmSetAt V xs v i puts v at the position i of xs. A position after the
-- end leaves xs unchanged. The length of xs does not change.
fmSetAt : (V : Type 0) → (xs : FreeMon V) → (v : V) → (i : ℕ) → FreeMon V
fmSetAt V xs v i = fmSetLen V v i (fmLength V xs) xs

-- spentAdd s k puts the key k in the spent set s. The keys ascend, so the
-- order of the puts does not change the list.
spentAdd : (s : FreeMon ℕ) → (k : ℕ) → FreeMon ℕ
spentAdd s k = ind (λ (x : FreeMon ℕ) → FreeMon ℕ) (fmCons ℕ k (fmNil ℕ)) (λ (h : ℕ) (t : FreeMon ℕ) (ih : FreeMon ℕ) → flagIf (natEq h k) (fmCons ℕ h t) (flagIf (natLt k h) (fmCons ℕ k (fmCons ℕ h t)) (fmCons ℕ h ih))) s

-- stEntry M s makes an entry: pos becomes pos + 1.
stEntry : (M : CMon) → (s : St M) → St M
stEntry M s = stMk M (stKappa M s) (stEpoch M s) (natAdd (stPos M s) 1) (stLedger M s) (stCredit M s) (stClaims M s) (stSpent M s) (stGammaE M s) (stGammaA M s)

-- stSetGammaE M s ge and stSetGammaA M s ga replace one map of s.
stSetGammaE : (M : CMon) → (s : St M) → (ge : FreeMon (ℕ × FreeMon (Option DecE))) → St M
stSetGammaE M s ge = stMk M (stKappa M s) (stEpoch M s) (stPos M s) (stLedger M s) (stCredit M s) (stClaims M s) (stSpent M s) ge (stGammaA M s)

stSetGammaA : (M : CMon) → (s : St M) → (ga : FreeMon (ℕ × Motion)) → St M
stSetGammaA M s ga = stMk M (stKappa M s) (stEpoch M s) (stPos M s) (stLedger M s) (stCredit M s) (stClaims M s) (stSpent M s) (stGammaE M s) ga

-- deposit p q iota (L334, L347 to L349). A spent receipt gives none. If
-- not, the ledger of p gets nu(iota), the claim (p, q, nu(iota)) gets the
-- index pos and the configuration bot^M, the key of iota is spent and pos
-- becomes pos + 1.
runDeposit : (M : CMon) → (p : Address) → (q : Address) → (r : Receipt M) → (s : St M) → T M (St M)
runDeposit M p q r s = flagIf (spentHas (stSpent M s) (receiptId M r)) (tNone M (St M)) (tRet M (St M) (stMk M (stKappa M s) (stEpoch M s) (natAdd (stPos M s) 1) (ledgerAdd M (stLedger M s) p (receiptNu M r)) (stCredit M s) (nmapSet (Claim M) (stClaims M s) (stPos M s) (pack p (pack q (receiptNu M r)))) (spentAdd (stSpent M s) (receiptId M r)) (nmapSet (FreeMon (Option DecE)) (stGammaE M s) (stPos M s) (botE (stKappa M s))) (stGammaA M s)))

-- A ballot b of vote u b (L358): an escrow verdict on the claim u, or an
-- amendment ballot on the motion u.
data Vote : Type where
  voteE : (voteEVerdict : DecE) → Vote
  voteA : (voteABallot : BallotA) → Vote

-- cast X (L353, L354) is always defined and makes no entry. Its state
-- meaning is the identity for any configuration X, independent of claims.
-- kappaF supplies the clear verdict theta(tau(X)) separately.
runCast : (M : CMon) → (x : FreeMon (Option DecE)) → (s : St M) → T M (St M)
runCast M x s = tRet M (St M) s

-- vote m u b (L358, L541, L542): the member m puts b at its position in
-- the configuration of u, and pos becomes pos + 1. A second vote of m
-- replaces the first, so the length of the configuration does not change.
-- A requester that is not in M or an unknown u gives none.
runVote : (M : CMon) → (m : Address) → (u : ℕ) → (b : Vote) → (s : St M) → T M (St M)
runVote M m u b s = option (tNone M (St M)) (λ (i : ℕ) → ind (λ (y : Vote) → T M (St M)) (λ (d : DecE) → option (tNone M (St M)) (λ (x : FreeMon (Option DecE)) → tRet M (St M) (stEntry M (stSetGammaE M s (nmapSet (FreeMon (Option DecE)) (stGammaE M s) u (fmSetAt (Option DecE) x (some d) i))))) (nmapGet (FreeMon (Option DecE)) (stGammaE M s) u)) (λ (v : BallotA) → option (tNone M (St M)) (λ (j : Motion) → tRet M (St M) (stEntry M (stSetGammaA M s (nmapSet Motion (stGammaA M s) u (pack (motionKappa j) (fmSetAt (Option BallotA) (motionConfig j) (some v) i)))))) (nmapGet Motion (stGammaA M s) u)) b) (memberIndex (kappaMembers (stKappa M s)) m)

-- balance a (L567) and amend (L411, L412) make no entry. propose p ; q
-- (L415 to L417) is vacuous over the discrete Obj_M.
runBalance : (M : CMon) → (a : Address) → (s : St M) → T M (St M)
runBalance M a s = tRet M (St M) s

runAmend : (M : CMon) → (s : St M) → T M (St M)
runAmend M s = tRet M (St M) s

runPropose : (M : CMon) → (s : St M) → T M (St M)
runPropose M s = tRet M (St M) s

-- predEq z gives j with j + 1 = z, or none when z is 0.
predEq : (z : ℕ) → Option ((j : ℕ) × Eq ℕ (natAdd j 1) z)
predEq z = ind (λ (x : ℕ) → Option ((j : ℕ) × Eq ℕ (natAdd j 1) x)) none (λ (j : ℕ) (r : Option ((i : ℕ) × Eq ℕ (natAdd i 1) j)) → some (pack j refl)) z

-- zeroEq z gives a proof of 0 = z, or none when z is not 0.
zeroEq : (z : ℕ) → Option (Eq ℕ 0 z)
zeroEq z = ind (λ (x : ℕ) → Option (Eq ℕ 0 x)) (some refl) (λ (j : ℕ) (r : Option (Eq ℕ 0 j)) → none) z

-- natSpan b a gives d with d + a = b, or none when a > b. A counter pass
-- over a: each step takes the predecessor of d (predEq).
natSpan : (b : ℕ) → (a : ℕ) → Option ((d : ℕ) × Eq ℕ (natAdd d a) b)
natSpan b a = ind (λ (x : ℕ) → Option ((d : ℕ) × Eq ℕ (natAdd d x) b)) (some (pack b refl)) (λ (i : ℕ) (ih : Option ((d : ℕ) × Eq ℕ (natAdd d i) b)) → option none (λ (p : (d : ℕ) × Eq ℕ (natAdd d i) b) → option none (λ (q : (j : ℕ) × Eq ℕ (natAdd j 1) (witness p)) → some (pack (witness q) (trans (symm (natAddOneL (witness q) i)) (trans (cong (λ (w : ℕ) → natAdd w i) (payload q)) (payload p))))) (predEq (witness p))) ih) a

-- natAdd 0 a = a, by ind on a. natAdd b 0 = b is definitional.
natAddZeroL : (a : ℕ) → Eq ℕ (natAdd 0 a) a
natAddZeroL a = ind (λ (m : ℕ) → Eq ℕ (natAdd 0 m) m) refl (λ (m : ℕ) (ih : Eq ℕ (natAdd 0 m) m) → cong (λ (x : ℕ) → natAdd x 1) ih) a

-- A decision for a = b on ℕ: natSpan gives d with d + a = b, then zeroEq
-- tests d = 0. settle uses it for the length proof of kappaF.
natEqDec : (a : ℕ) → (b : ℕ) → Option (Eq ℕ a b)
natEqDec a b = option none (λ (p : (d : ℕ) × Eq ℕ (natAdd d a) b) → option none (λ (r : Eq ℕ 0 (witness p)) → some (trans (symm (natAddZeroL a)) (trans (cong (λ (w : ℕ) → natAdd w a) r) (payload p)))) (zeroEq (witness p))) (natSpan b a)

-- Setters of St M: the ledger and the credit, and the close of claim c
-- (the claim and its Gamma_E entry leave their maps, D54).
stSetBooks : (M : CMon) → (s : St M) → (l : Ledger M) → (cr : Ledger M) → St M
stSetBooks M s l cr = stMk M (stKappa M s) (stEpoch M s) (stPos M s) l cr (stClaims M s) (stSpent M s) (stGammaE M s) (stGammaA M s)

stCloseClaim : (M : CMon) → (s : St M) → (c : ℕ) → St M
stCloseClaim M s c = stMk M (stKappa M s) (stEpoch M s) (stPos M s) (stLedger M s) (stCredit M s) (nmapDel (Claim M) (stClaims M s) c) (stSpent M s) (nmapDel (FreeMon (Option DecE)) (stGammaE M s) c) (stGammaA M s)

-- settle c (L547 to L555) reads the current kappa (O-off-1). Release and
-- Refund take n from the ledger of the payer p and add n to the credit of
-- r (the payee q for Release, p for Refund), then close c. Hold makes an
-- entry only.
runSettlePay : (M : CMon) → (c : ℕ) → (p : Address) → (r : Address) → (n : cmCarrier M) → (s : St M) → T M (St M)
runSettlePay M c p r n s = option (tNone M (St M)) (λ (l : Ledger M) → tRet M (St M) (stEntry M (stCloseClaim M (stSetBooks M s l (ledgerAdd M (stCredit M s) r n)) c))) (ledgerSub M (stLedger M s) p n)

runSettleDec : (M : CMon) → (c : ℕ) → (x : Claim M) → (d : DecE) → (s : St M) → T M (St M)
runSettleDec M c x d s = ind (λ (y : DecE) → T M (St M)) (runSettlePay M c (claimPayer M x) (claimPayee M x) (claimAmount M x) s) (runSettlePay M c (claimPayer M x) (claimPayer M x) (claimAmount M x) s) (tRet M (St M) (stEntry M s)) d

-- settle stops if X_c is not ready. natEqDec gives the length proof of
-- X_c; the value none does not occur on a valid w.
runSettleAt : (M : CMon) → (c : ℕ) → (x : Claim M) → (xc : FreeMon (Option DecE)) → (s : St M) → T M (St M)
runSettleAt M c x xc s = flagIf (tallyReady (fmLength (Option DecE) xc) (kappaT (stKappa M s)) (tauE xc)) (option (tNone M (St M)) (λ (e : Eq ℕ (fmLength (Option DecE) xc) (kappaN (stKappa M s))) → runSettleDec M c x (kappaF (stKappa M s) xc e) s) (natEqDec (fmLength (Option DecE) xc) (kappaN (stKappa M s)))) (tNone M (St M))

-- An unknown claim or Gamma_E entry stops settle.
runSettle : (M : CMon) → (c : ℕ) → (s : St M) → T M (St M)
runSettle M c s = option (tNone M (St M)) (λ (x : Claim M) → option (tNone M (St M)) (λ (xc : FreeMon (Option DecE)) → runSettleAt M c x xc s) (nmapGet (FreeMon (Option DecE)) (stGammaE M s) c)) (nmapGet (Claim M) (stClaims M s) c)

-- withdraw a n (L380, L381, L559 to L563): n leaves the credit of a, and
-- the voucher (a, n, i) goes to the output at the entry index i.
runWithdraw : (M : CMon) → (a : Address) → (n : cmCarrier M) → (s : St M) → T M (St M)
runWithdraw M a n s = option (tNone M (St M)) (λ (cr : Ledger M) → tEmit M (St M) (pack a (pack n (stPos M s))) (tRet M (St M) (stEntry M (stSetBooks M s (stLedger M s) cr)))) (ledgerSub M (stCredit M s) a n)

-- motion m kappa' (L390, L571, L572): m is a member and kappa' is well
-- formed, else motion stops. The motion index is the entry index, and
-- Y_j is bot^M.
runMotion : (M : CMon) → (m : Address) → (k2 : Kappa) → (s : St M) → T M (St M)
runMotion M m k2 s = option (tNone M (St M)) (λ (i : ℕ) → flagIf (kappaWellFormed k2) (tRet M (St M) (stEntry M (stSetGammaA M s (nmapSet Motion (stGammaA M s) (stPos M s) (pack k2 (botA (stKappa M s))))))) (tNone M (St M))) (memberIndex (kappaMembers (stKappa M s)) m)

-- clear_{M'} (L403, O-off-2): each open X_c and each open Y_j' becomes
-- bot^{M'}. The keys and the proposed kappa of each motion stay.
clearE : (k : Kappa) → (ge : FreeMon (ℕ × FreeMon (Option DecE))) → FreeMon (ℕ × FreeMon (Option DecE))
clearE k ge = fold (fmNil (ℕ × FreeMon (Option DecE))) (λ (h : ℕ × FreeMon (Option DecE)) (acc : FreeMon (ℕ × FreeMon (Option DecE))) → fmCons (ℕ × FreeMon (Option DecE)) (pack (witness h) (botE k)) acc) ge

clearA : (k : Kappa) → (ga : FreeMon (ℕ × Motion)) → FreeMon (ℕ × Motion)
clearA k ga = fold (fmNil (ℕ × Motion)) (λ (h : ℕ × Motion) (acc : FreeMon (ℕ × Motion)) → fmCons (ℕ × Motion) (pack (witness h) (pack (motionKappa (payload h)) (botA k))) acc) ga

-- stAdopt M j k2 s: k2 is kappa', the epoch becomes e + 1, the motion j
-- closes, and clear_{M'} sets each open configuration to bot^{M'}.
stAdopt : (M : CMon) → (j : ℕ) → (k2 : Kappa) → (s : St M) → St M
stAdopt M j k2 s = stMk M k2 (natAdd (stEpoch M s) 1) (stPos M s) (stLedger M s) (stCredit M s) (stClaims M s) (stSpent M s) (clearE k2 (stGammaE M s)) (clearA k2 (nmapDel Motion (stGammaA M s) j))

-- enact j (L397 to L403) on the verdict d. Adopt installs kappa' of the
-- motion and clears. Reject closes j. Hold keeps the state. Each verdict
-- makes an entry.
runEnactDec : (M : CMon) → (j : ℕ) → (y : Motion) → (d : DecA) → (s : St M) → T M (St M)
runEnactDec M j y d s = ind (λ (z : DecA) → T M (St M)) (tRet M (St M) (stEntry M (stAdopt M j (motionKappa y) s))) (tRet M (St M) (stEntry M (stSetGammaA M s (nmapDel Motion (stGammaA M s) j)))) (tRet M (St M) (stEntry M s)) d

-- Amd_tA of the current kappa on Y_j (L395). natEqDec gives the length
-- proof of Y_j; the value none does not occur on a valid w.
enactAmd : (M : CMon) → (y : Motion) → (s : St M) → Option DecA
enactAmd M y s = option none (λ (e : Eq ℕ (fmLength (Option BallotA) (motionConfig y)) (kappaN (stKappa M s))) → some (kappaAmd (stKappa M s) (transport (λ (m : ℕ) → TallyA m) e (tauA (motionConfig y))))) (natEqDec (fmLength (Option BallotA) (motionConfig y)) (kappaN (stKappa M s)))

runEnactAt : (M : CMon) → (j : ℕ) → (y : Motion) → (s : St M) → T M (St M)
runEnactAt M j y s = option (tNone M (St M)) (λ (d : DecA) → runEnactDec M j y d s) (enactAmd M y s)

-- An unknown or closed motion j stops enact.
runEnact : (M : CMon) → (j : ℕ) → (s : St M) → T M (St M)
runEnact M j s = option (tNone M (St M)) (λ (y : Motion) → runEnactAt M j y s) (nmapGet Motion (stGammaA M s) j)

-- Thm 4.3 (L405): enact does not change the escrow part pi_E s (ledger,
-- credit, claims and spent). escrowOf gives pi_E of the result, and
-- escrowAs puts e as the result. Each branch of runEnactDec keeps the
-- escrow part, so the proof is by ind on DecA, then by ind on Option.
Escrow : (M : CMon) → Type 0
Escrow M = Ledger M × Ledger M × FreeMon (ℕ × Claim M) × FreeMon ℕ

stEscrow : (M : CMon) → (s : St M) → Escrow M
stEscrow M s = pack (stLedger M s) (pack (stCredit M s) (pack (stClaims M s) (stSpent M s)))

escrowOf : (M : CMon) → (t : T M (St M)) → T M (Escrow M)
escrowOf M t = tBind M (St M) (Escrow M) t (λ (s2 : St M) → tRet M (Escrow M) (stEscrow M s2))

escrowAs : (M : CMon) → (t : T M (St M)) → (e : Escrow M) → T M (Escrow M)
escrowAs M t e = tBind M (St M) (Escrow M) t (λ (s2 : St M) → tRet M (Escrow M) e)

enactEscrowDec : (M : CMon) → (j : ℕ) → (y : Motion) → (d : DecA) → (s : St M) → Eq (T M (Escrow M)) (escrowOf M (runEnactDec M j y d s)) (escrowAs M (runEnactDec M j y d s) (stEscrow M s))
enactEscrowDec M j y d s = ind (λ (z : DecA) → Eq (T M (Escrow M)) (escrowOf M (runEnactDec M j y z s)) (escrowAs M (runEnactDec M j y z s) (stEscrow M s))) refl refl refl d

enactEscrowAt : (M : CMon) → (j : ℕ) → (y : Motion) → (s : St M) → Eq (T M (Escrow M)) (escrowOf M (runEnactAt M j y s)) (escrowAs M (runEnactAt M j y s) (stEscrow M s))
enactEscrowAt M j y s = ind (λ (p : Option DecA) → Eq (T M (Escrow M)) (escrowOf M (option (tNone M (St M)) (λ (d : DecA) → runEnactDec M j y d s) p)) (escrowAs M (option (tNone M (St M)) (λ (d : DecA) → runEnactDec M j y d s) p) (stEscrow M s))) refl (λ (d : DecA) → enactEscrowDec M j y d s) (enactAmd M y s)

enactEscrow : (M : CMon) → (j : ℕ) → (s : St M) → Eq (T M (Escrow M)) (escrowOf M (runEnact M j s)) (escrowAs M (runEnact M j s) (stEscrow M s))
enactEscrow M j s = ind (λ (o : Option Motion) → Eq (T M (Escrow M)) (escrowOf M (option (tNone M (St M)) (λ (y : Motion) → runEnactAt M j y s) o)) (escrowAs M (option (tNone M (St M)) (λ (y : Motion) → runEnactAt M j y s) o) (stEscrow M s))) refl (λ (y : Motion) → enactEscrowAt M j y s) (nmapGet Motion (stGammaA M s) j)

-- One transcript entry: one constructor for each operation of PLAN 3.2.
-- The requester (m of vote and motion, a of withdraw and balance) is a
-- field. amend and propose are identities, so they have no field.
data Op (M : CMon) : Type where
  opDeposit : (opDepositPayer : Address) → (opDepositPayee : Address) → (opDepositReceipt : Receipt M) → Op M
  opCast : (opCastConfig : FreeMon (Option DecE)) → Op M
  opVote : (opVoteMember : Address) → (opVoteIndex : ℕ) → (opVoteBallot : Vote) → Op M
  opSettle : (opSettleClaim : ℕ) → Op M
  opWithdraw : (opWithdrawRequester : Address) → (opWithdrawAmount : cmCarrier M) → Op M
  opBalance : (opBalanceRequester : Address) → Op M
  opMotion : (opMotionMember : Address) → (opMotionKappa : Kappa) → Op M
  opEnact : (opEnactMotion : ℕ) → Op M
  opAmend : Op M
  opPropose : Op M

-- The op of the transcript meaning tSem M (Op M) (St M) (opStep M).
opStep : (M : CMon) → (x : Op M) → (s : St M) → T M (St M)
opStep M x s = ind (λ (y : Op M) → T M (St M)) (λ (p : Address) (q : Address) (r : Receipt M) → runDeposit M p q r s) (λ (xc : FreeMon (Option DecE)) → runCast M xc s) (λ (m : Address) (u : ℕ) (b : Vote) → runVote M m u b s) (λ (c : ℕ) → runSettle M c s) (λ (a : Address) (n : cmCarrier M) → runWithdraw M a n s) (λ (a : Address) → runBalance M a s) (λ (m : Address) (k : Kappa) → runMotion M m k s) (λ (j : ℕ) → runEnact M j s) (runAmend M s) (runPropose M s) x

-- Invariant I (Thm 4.1): sumClaims M cl p is the sum of the amounts of
-- the open claims of the payer p. Conservation (Thm 4.4): ledgerSum M m
-- is the sum of the values of a ledger, and voucherSum M v is the sum of
-- the amounts of a list of vouchers.
sumClaims : (M : CMon) → (cl : FreeMon (ℕ × Claim M)) → (p : Address) → cmCarrier M
sumClaims M cl p = fold (cmZero M) (λ (h : ℕ × Claim M) (acc : cmCarrier M) → flagIf (natEq (addressKey (claimPayer M (payload h))) (addressKey p)) (cmAdd M (claimAmount M (payload h)) acc) acc) cl

ledgerSum : (M : CMon) → (m : Ledger M) → cmCarrier M
ledgerSum M m = fold (cmZero M) (λ (h : ℕ × cmCarrier M) (acc : cmCarrier M) → cmAdd M (payload h) acc) m

voucherSum : (M : CMon) → (v : FreeMon (Voucher M)) → cmCarrier M
voucherSum M v = fold (cmZero M) (λ (h : Voucher M) (acc : cmCarrier M) → cmAdd M (voucherAmount M h) acc) v
